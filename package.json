{
  "name": "graph-engine",
  "version": "2.0.0",
  "description": "A reusable graph platform for Obsidian with the graph+ experience built in.",
  "private": true,
  "main": "main.js",
  "scripts": {
    "build": "npm run build:client && node esbuild.config.js",
    "build:client": "node scripts/build-graph-engine-client.mjs",
    "watch": "node esbuild.config.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "node test.config.js",
    "benchmark": "node scripts/benchmark-graph-engine.mjs",
    "dev": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.5.1",
    "esbuild": "^0.18.11",
    "fast-glob": "^3.3.3",
    "happy-dom": "^20.11.6",
    "obsidian": "^1.11.0",
    "ts-morph": "^27.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.1.6"
  }
}
